# ==========================================
# HeyCoderz Environment Variables Configuration
# ==========================================

# 1. Resend Email Service Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="your_resend_api_key_here"

# Sender address (Must be verified in Resend Dashboard)
RESEND_FROM_EMAIL="HeyCoderz <verification@heycoderz.com>"

# 2. Application Base URL (Used for generating verification links)
# Production: https://heycoderz.com
# Local Development: http://localhost:3000
NEXT_PUBLIC_APP_URL="https://heycoderz.com"

# 3. Database / Upstash Cloud KV Configuration
UPSTASH_REDIS_REST_URL="your_upstash_redis_url"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# 4. Cloudflare Turnstile Configuration
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_turnstile_site_key_here"
TURNSTILE_SECRET_KEY="your_turnstile_secret_key_here"

# 5. Authentication Session Secret
AUTH_SECRET_KEY="your_auth_secret_key_here"
